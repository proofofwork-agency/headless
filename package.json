{
  "name": "@proofofwork-agency/headless",
  "version": "0.2.0",
  "description": "Universal headless runner and local control plane for AI coding CLIs with a native JSONL ledger and OpenCode plugin tools.",
  "packageManager": "bun@1.3.14",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./mcp": {
      "types": "./dist/mcp/server.d.ts",
      "import": "./dist/mcp/server.js",
      "default": "./dist/mcp/server.js"
    },
    "./daemon": {
      "types": "./dist/daemon/client.d.ts",
      "import": "./dist/daemon/client.js",
      "default": "./dist/daemon/client.js"
    },
    "./broker/linux-relay": {
      "types": "./dist/broker/linux-relay.d.ts",
      "import": "./dist/broker/linux-relay.js",
      "default": "./dist/broker/linux-relay.js"
    }
  },
  "bin": {
    "headless": "./dist/cli.js",
    "hless": "./dist/hless.js",
    "headless-mcp": "./dist/mcp/server.js"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "docs/mcp-integration.md",
    "docs/native-login.md",
    "docs/plan.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun run clean && bun build ./src/cli.ts ./src/hless.ts ./src/index.ts ./src/mcp/server.ts ./src/daemon/client.ts ./src/broker/linux-relay.ts --root ./src --outdir ./dist --target bun && bun build ./src/tui/App.tsx --outdir ./dist/tui --target bun && bun run build:types && bun run --cwd plugin build",
    "build:types": "bunx tsc --emitDeclarationOnly --outDir dist",
    "dev": "bun --watch src/cli.ts",
    "typecheck": "bunx tsc --noEmit",
    "test": "bun test tests",
    "typecheck:plugin": "bun run --cwd plugin typecheck",
    "lint": "bun scripts/source-hygiene.ts lint",
    "format:check": "bun scripts/source-hygiene.ts format",
    "check:docs": "bun scripts/docs-check.ts",
    "check": "bun run typecheck && bun run typecheck:plugin && bun run lint && bun run format:check && bun run check:docs && bun run test",
    "smoke:pack": "bun scripts/pack-smoke.ts",
    "smoke:native": "bun scripts/native-subscription-smoke.ts",
    "smoke:providers": "bun scripts/provider-smoke.ts",
    "release:check": "bun run check && bun run build && bun run smoke:pack",
    "clean": "rm -rf dist plugin/dist",
    "prepack": "bun run build",
    "prepublishOnly": "bun run release:check"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "ink": "^7.1.0",
    "react": "^19.2.7",
    "react-devtools-core": "^7.0.1",
    "zod": "^3.24.0",
    "zod-to-json-schema": "^3.24.6"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "1.17.17",
    "@types/bun": "latest",
    "@types/react": "^19.2.17",
    "typescript": "^5.6.0"
  },
  "engines": {
    "bun": ">=1.1.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/proofofwork-agency/headless"
  }
}
